#!/usr/bin/env bash
set -euo pipefail

BASE=/opt/ai-hq
RELEASES="$BASE/releases"
APP_LINK="$BASE/app"
ENV_FILE=/etc/ai-hq/ai-hq.env
PUBLISH_TOKEN_SOURCE=/etc/ai-hq/github-publisher.token
DRIPVID_MCP_SOCKET=/run/dripvid-mcp/mcp.sock
DRIPVID_MCP_TOKEN_SOURCE=/etc/ai-hq/dripvid-mcp.token
KEEP_RELEASES=5

fail(){ echo "ai-hq-deploy: $*" >&2; exit 1; }

[[ $# -eq 2 ]] || fail "usage: ai-hq-deploy <sha> <archive>"
SHA="$1"
ARCHIVE="$2"
[[ "$SHA" =~ ^[0-9a-f]{40}$ ]] || fail "invalid commit SHA"
EXPECTED="/tmp/ai-hq-release-${SHA}.tgz"
[[ "$ARCHIVE" == "$EXPECTED" ]] || fail "unexpected archive path"
[[ -f "$ARCHIVE" ]] || fail "release archive not found"
[[ -f "$ENV_FILE" ]] || fail "production environment file is missing"

for command in flock tar docker curl nginx stat; do
  command -v "$command" >/dev/null || fail "$command is required"
done

# Production activation is deliberately fail-closed and starts safe/simulated.
grep -Eq '^AI_HQ_ADMIN_PASSWORD_HASH=.+$' "$ENV_FILE" || fail "AI HQ admin password hash is missing"
grep -Eq '^AI_HQ_SESSION_SECRET=.{32,}$' "$ENV_FILE" || fail "AI HQ session secret is missing or too short"
grep -Eq '^AI_HQ_OPERATING_MODE=safe$' "$ENV_FILE" || fail "AI HQ must deploy in safe mode"
grep -Eq '^AI_HQ_SIMULATION_MODE=true$' "$ENV_FILE" || fail "AI HQ must deploy with simulation mode enabled"
grep -Eq '^AI_HQ_HOST_HELPER_CREDENTIAL=[A-Za-z0-9_-]{32,128}$' "$ENV_FILE" || fail "Host Helper credential is missing; run deploy/install-host-helper.sh first"
test -S /run/ai-hq/host-helper.sock || fail "Host Helper socket is missing; run deploy/install-host-helper.sh first"

grep -Fxq 'AI_HQ_GITHUB_PUBLISH_TOKEN_SOURCE=/etc/ai-hq/github-publisher.token' "$ENV_FILE" || fail "GitHub publisher token source is missing; run deploy/install-github-publisher-token.sh first"
[[ -f "$PUBLISH_TOKEN_SOURCE" && ! -L "$PUBLISH_TOKEN_SOURCE" ]] || fail "GitHub publisher token file must be a regular non-symlink file"
TOKEN_MODE="$(stat -c '%a' "$PUBLISH_TOKEN_SOURCE")"
TOKEN_UID="$(stat -c '%u' "$PUBLISH_TOKEN_SOURCE")"
[[ "$TOKEN_UID" == "0" ]] || fail "GitHub publisher token file must be owned by root"
(( (8#$TOKEN_MODE & 077) == 0 )) || fail "GitHub publisher token file permissions are too broad"
grep -q '[^[:space:]]' "$PUBLISH_TOKEN_SOURCE" || fail "GitHub publisher token file is empty"

grep -Fxq 'AI_HQ_DRIPVID_MCP_SOCKET=/run/dripvid-mcp/mcp.sock' "$ENV_FILE" || fail "DripVid MCP socket path is missing"
grep -Fxq 'AI_HQ_DRIPVID_MCP_TOKEN_FILE=/run/secrets/dripvid-mcp-token' "$ENV_FILE" || fail "DripVid MCP container token path is missing"
grep -Fxq 'AI_HQ_DRIPVID_MCP_TOKEN_SOURCE=/etc/ai-hq/dripvid-mcp.token' "$ENV_FILE" || fail "DripVid MCP token source is missing"
test -S "$DRIPVID_MCP_SOCKET" || fail "DripVid MCP socket is missing; deploy the DripVid MCP service first"
[[ -f "$DRIPVID_MCP_TOKEN_SOURCE" && ! -L "$DRIPVID_MCP_TOKEN_SOURCE" ]] || fail "DripVid MCP token file must be a regular non-symlink file"
MCP_TOKEN_MODE="$(stat -c '%a' "$DRIPVID_MCP_TOKEN_SOURCE")"
MCP_TOKEN_UID="$(stat -c '%u' "$DRIPVID_MCP_TOKEN_SOURCE")"
[[ "$MCP_TOKEN_UID" == "0" ]] || fail "DripVid MCP token file must be owned by root"
(( (8#$MCP_TOKEN_MODE & 077) == 0 )) || fail "DripVid MCP token file permissions are too broad"
grep -Eq '^[^[:space:]]+$' "$DRIPVID_MCP_TOKEN_SOURCE" || fail "DripVid MCP token file is empty or contains whitespace"

grep -Fxq 'AI_HQ_REPOSITORY_MIRROR_ROOT=/srv/ai-hq/repository-mirrors' "$ENV_FILE" || fail "trusted repository mirror root is missing"
grep -Fxq 'AI_HQ_REPOSITORY_SANDBOX_ROOT=/srv/ai-hq/repository-sandboxes' "$ENV_FILE" || fail "repository sandbox root is missing"
grep -Fxq 'AI_HQ_AI_HQ_REPOSITORY_SOURCE=/srv/ai-hq/repository-mirrors/ai-hq' "$ENV_FILE" || fail "AI HQ trusted repository source is missing"
grep -Fxq 'AI_HQ_DRIPVID_REPOSITORY_SOURCE=/srv/ai-hq/repository-mirrors/dripvid' "$ENV_FILE" || fail "DripVid trusted repository source is missing"

test -d /opt/ai-hq/repository-mirrors/ai-hq || fail "AI HQ trusted repository mirror is missing"
test -d /opt/ai-hq/repository-mirrors/dripvid || fail "DripVid trusted repository mirror is missing"
test -d /opt/ai-hq/repository-mirrors/dripvid/node_modules || fail "DripVid trusted dependency cache is missing"
test -d /opt/ai-hq/repository-sandboxes || fail "repository sandbox directory is missing"

nginx -t >/dev/null

exec 9>/run/lock/ai-hq-deploy.lock
flock -n 9 || fail "another AI HQ deployment is already running"
trap 'rm -f "$ARCHIVE"' EXIT

mkdir -p "$RELEASES"
RELEASE="$RELEASES/$SHA"
rm -rf "$RELEASE"
mkdir -p "$RELEASE"
tar -xzf "$ARCHIVE" -C "$RELEASE" --no-same-owner --no-same-permissions

for required in pyproject.toml compose.yaml Dockerfile docker/entrypoint-web.sh; do
  [[ -f "$RELEASE/$required" ]] || fail "release is missing $required"
done

compose_release() {
  local release="$1"
  shift
  AI_HQ_ENV_FILE="$ENV_FILE" docker compose \
    -p ai-hq \
    --env-file "$ENV_FILE" \
    -f "$release/compose.yaml" \
    "$@"
}

database_revision() {
  local release="$1"
  compose_release "$release" exec -T postgres sh -eu -c '
    psql \
      -U "$POSTGRES_USER" \
      -d "$POSTGRES_DB" \
      -Atc "SELECT version_num FROM alembic_version;"
  '
}

activate_release_link() {
  local release="$1"
  local label="$2"
  local next_link="$BASE/.app-${label}"

  rm -f "$next_link"
  ln -s "$release" "$next_link"
  mv -Tf "$next_link" "$APP_LINK"
}

compose_release "$RELEASE" config >/dev/null

PREVIOUS=""
if [[ -L "$APP_LINK" ]]; then
  PREVIOUS="$(readlink -f "$APP_LINK" || true)"
elif [[ -e "$APP_LINK" ]]; then
  fail "$APP_LINK must be a symlink before automatic deployment"
fi

DB_REVISION_BEFORE=""
if [[ -n "$PREVIOUS" ]]; then
  if ! DB_REVISION_BEFORE="$(database_revision "$PREVIOUS")"; then
    fail "database revision could not be verified before deployment"
  fi
  [[ -n "$DB_REVISION_BEFORE" ]] || fail "database revision could not be verified before deployment"
fi

rollback() {
  echo "ai-hq-deploy: rollback started" >&2
  if [[ -n "$PREVIOUS" && -d "$PREVIOUS" && -f "$PREVIOUS/compose.yaml" ]]; then
    compose_release "$PREVIOUS" up -d --build
    activate_release_link "$PREVIOUS" "rollback"
  else
    compose_release "$RELEASE" down || true
  fi
}

compose_release "$RELEASE" up -d --build

healthy=false
for _ in $(seq 1 40); do
  if curl -fsS --max-time 3 http://127.0.0.1:8090/health/ready >/dev/null; then
    healthy=true
    break
  fi
  sleep 2
done

if [[ "$healthy" != true ]]; then
  if [[ -n "$PREVIOUS" ]]; then
    DB_REVISION_AFTER=""
    if ! DB_REVISION_AFTER="$(database_revision "$RELEASE")"; then
      activate_release_link "$RELEASE" "recovery-${SHA}"
      fail "database revision could not be verified after readiness failure; refusing automatic rollback"
    fi

    if [[ -z "$DB_REVISION_AFTER" ]]; then
      activate_release_link "$RELEASE" "recovery-${SHA}"
      fail "database revision could not be verified after readiness failure; refusing automatic rollback"
    fi

    if [[ "$DB_REVISION_AFTER" == "$DB_REVISION_BEFORE" ]]; then
      rollback
      fail "new release failed readiness and was rolled back"
    fi

    activate_release_link "$RELEASE" "recovery-${SHA}"
    fail "new release failed readiness and database revision changed during deployment; automatic rollback is unsafe"
  fi

  compose_release "$RELEASE" down || true
  fail "new release failed readiness"
fi

activate_release_link "$RELEASE" "$SHA"

CURRENT="$(readlink -f "$APP_LINK")"
mapfile -t OLD_RELEASES < <(
  find "$RELEASES" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' |
    sort -nr |
    awk -v keep="$KEEP_RELEASES" 'NR>keep{$1="";sub(/^ /,"");print}'
)
for old in "${OLD_RELEASES[@]:-}"; do
  [[ -n "$old" ]] || continue
  [[ "$old" == "$CURRENT" ]] && continue
  [[ -n "$PREVIOUS" && "$old" == "$PREVIOUS" ]] && continue
  rm -rf -- "$old"
done

echo "ai-hq-deploy: deployed $SHA successfully"
echo "ai-hq-deploy: active release $CURRENT"
echo "ai-hq-deploy: run deploy/check-production.sh after the validated Nginx /ai-hq route is active"

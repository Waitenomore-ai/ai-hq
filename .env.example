AI_HQ_ENVIRONMENT=development
AI_HQ_DATABASE_URL=postgresql+psycopg://ai_hq:change-me@postgres:5432/ai_hq
AI_HQ_REDIS_URL=redis://redis:6379/0
AI_HQ_OPERATING_MODE=safe
AI_HQ_SIMULATION_MODE=true
AI_HQ_LOG_LEVEL=INFO
AI_HQ_ROOT_PATH=/ai-hq
AI_HQ_ADMIN_PASSWORD_HASH=replace-with-argon2-hash-not-plaintext-password
AI_HQ_SESSION_SECRET=replace-with-at-least-32-random-characters
AI_HQ_SESSION_LIFETIME_HOURS=12
POSTGRES_DB=ai_hq
POSTGRES_USER=ai_hq
POSTGRES_PASSWORD=change-me

# SysAdmin Chat v1 model provider
# OpenAI-compatible /v1/chat/completions endpoint.
# This may be a local model server or compatible hosted provider.
AI_HQ_CHAT_MODEL_BASE_URL=
AI_HQ_CHAT_MODEL_NAME=
AI_HQ_CHAT_MODEL_API_KEY=
AI_HQ_CHAT_MODEL_TIMEOUT_SECONDS=15

# Free-first SysAdmin AI providers.
# Priority: local -> Groq -> OpenRouter free -> Hugging Face.
# Leave a provider blank to disable it.
AI_HQ_FREE_AI_LOCAL_BASE_URL=
AI_HQ_FREE_AI_LOCAL_MODEL=
AI_HQ_FREE_AI_LOCAL_API_KEY=

AI_HQ_FREE_AI_GROQ_API_KEY=
AI_HQ_FREE_AI_GROQ_MODEL=

# OpenRouter is hard-locked by AI HQ to model: openrouter/free
AI_HQ_FREE_AI_OPENROUTER_API_KEY=

# Hugging Face requires an explicitly approved model.
AI_HQ_FREE_AI_HF_TOKEN=
AI_HQ_FREE_AI_HF_MODEL=

AI_HQ_FREE_AI_TIMEOUT_SECONDS=15
